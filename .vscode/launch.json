{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "CERI: iniciar y abrir el administrador",
      "program": "${workspaceFolder}/herramientas/servidor.js",
      "cwd": "${workspaceFolder}",
      "env": {
        "PORT": "5501"
      },
      "console": "integratedTerminal",
      "outputCapture": "std",
      "serverReadyAction": {
        "pattern": "Panel editorial: (http://localhost:[0-9]+/admin/)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "CERI: iniciar y abrir la web",
      "program": "${workspaceFolder}/herramientas/servidor.js",
      "cwd": "${workspaceFolder}",
      "env": {
        "PORT": "5501"
      },
      "console": "internalConsole",
      "outputCapture": "std",
      "serverReadyAction": {
        "pattern": "(http://localhost:[0-9]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "CERI: abrir navegador (servidor encendido)",
      "url": "http://localhost:5501",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
