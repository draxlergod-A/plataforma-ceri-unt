{
  "name": "ceri-web",
  "version": "3.0.0",
  "description": "Web del Círculo de Estudios de Relaciones Internacionales (CERI) – Universidad Nacional de Trujillo",
  "private": true,
  "scripts": {
    "sitio": "node herramientas/servidor.js",
    "cuentas": "node herramientas/cuentas.js",
    "validar": "node herramientas/validar.js",
    "test": "node --test herramientas/admin.test.js",
    "test:admin": "node --test herramientas/admin.test.js",
    "formato": "prettier --write .",
    "revisar-formato": "prettier --check .",
    "comprobar": "npm run validar && npm test && npm run revisar-formato"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
